generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  username String  @unique @db.Citext
  email    String  @unique @db.Citext
  phone    String? @unique @db.VarChar(30)

  passwordHash String @map("password_hash") @db.VarChar(255)

  avatar String? @db.VarChar(300)

  role        UserRole @default(user)
  isActive    Boolean  @default(true) @map("is_active")
  authVersion Int      @default(0) @map("auth_version")

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(3)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  posts Post[]

  comments Comment[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Post {
  id       Int    @id @default(autoincrement())
  publicId String @unique @map("public_id") @db.VarChar(32)

  title     String  @db.VarChar(100)
  content   String
  summary   String? @db.VarChar(300)
  viewCount Int     @default(0) @map("view_count")

  status PostStatus @default(draft)

  authorId String @map("author_id") @db.Uuid
  author   User   @relation(fields: [authorId], references: [id])

  aliases PostAlias[]

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  tags PostTag[]

  comments Comment[]

  @@index([authorId])
  @@index([status])
  @@index([deletedAt])
  @@map("posts")
}

model PostAlias {
  id    Int    @id @default(autoincrement())
  alias String @unique @db.VarChar(100)

  postId Int  @map("post_id")
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([postId])
  @@map("post_aliases")
}

enum PostStatus {
  draft
  published

  @@map("post_status")
}

model Tag {
  id    Int       @id @default(autoincrement())
  name  String    @unique @db.Citext
  posts PostTag[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("tags")
}

model PostTag {
  postId Int @map("post_id")
  tagId  Int @map("tag_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

enum UserRole {
  admin
  editor
  user

  @@map("user_role")
}

model Comment {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content String @db.Text

  userId   String  @map("user_id") @db.Uuid
  postId   Int     @map("post_id")
  parentId String? @map("parent_id") @db.Uuid

  status CommentStatus @default(approved)
  ip     String        @db.VarChar(45)

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([postId])
  @@index([parentId])
  @@index([status])
  @@index([createdAt])
  @@map("comments")
}

enum CommentStatus {
  pending
  approved
  spam

  @@map("comment_status")
}

model Option {
  key       String   @id @db.Citext
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("options")
}
